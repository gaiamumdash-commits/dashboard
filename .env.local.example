# Copie para .env.local e preencha com as credenciais do projeto Supabase do Gaiamum Dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cliente OAuth dedicado do Google Calendar (Google Cloud Console → Google Auth
# Platform → Clientes) — separado do client usado pelo login. Ver
# src/lib/ecc/google-calendar.ts / google-calendar-interno.ts.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Cliente OAuth do login social "Entrar com Google" — client ID/secret
# DISTINTOS do par acima (login e Calendar são integrações separadas de
# propósito, mesmo indo os dois pro Google). Ver src/lib/ecc/auth-google.ts.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# Chave da API do Gemini (transcrição de voz e explicação do Alinhamento
# Gaiamum). Ver src/lib/ecc/gemini.ts.
GEMINI_API_KEY=

# Chave da API Anthropic (Claude) — usada hoje só pelo código de entrevista
# conversacional de Marketing (src/lib/ecc/ia.ts), que NÃO está no fluxo
# real de produção (ver docs/gaiamum/GAIAMUM-BLUEPRINT-PRODUTO-v1.md,
# seção IA). Necessária só pra build/tipo do SDK compilar.
ANTHROPIC_API_KEY=

# E-mail transacional (Resend) — convites, alarmes, consolidação de
# projeto, reengajamento do Lab. Ver src/lib/ecc/notificacoes.ts.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Segredo compartilhado que autentica os 3 endpoints de cron
# (/api/cron/*) — também salvo no Vault do Supabase pro job de pg_cron
# (ver supabase/migrations/0021_reforco_cron_alarmes.sql). NUNCA commitar
# o valor real.
CRON_SECRET=

# "true" fecha o cadastro público (só allowlist/convite pendente ganham
# workspace novo) — ausente ou qualquer outro valor = cadastro aberto
# (padrão). Ver src/lib/ecc/acesso-beta.ts.
MODO_CADASTRO_FECHADO=

# E-mail (só um) autorizado a ver /admin/analitica-lab — não é o mesmo
# conceito de "owner de um workspace" (ver src/lib/ecc/dono-saas.ts).
EMAIL_DONO_SAAS=

# Rate limit de chamadas de IA (P0, 2026-09-30) — opcionais, com defaults
# conservadores no código (ver src/lib/ecc/ia-rate-limit.ts) se deixados em
# branco. Ajustar aqui não exige mudar código nem redeploy de lógica.
IA_LIMITE_POR_USUARIO_MINUTO=
IA_LIMITE_POR_WORKSPACE_HORA=
IA_LIMITE_GLOBAL_HORA=

# Só para rodar os testes de integração/RLS locais (tests/integration/) —
# NUNCA aponte pro projeto de produção. Ver tests/integration/README.md.
# SUPABASE_TEST_URL=
# SUPABASE_TEST_ANON_KEY=
# SUPABASE_TEST_SERVICE_ROLE_KEY=
